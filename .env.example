# Neon Serverless Postgres (Singapore region ap-southeast-1 with connection pooling)
# Example: postgres://[user]:[password]@[ep-id]-pooler.ap-southeast-1.aws.neon.tech/[dbname]?sslmode=require
POSTGRES_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# JWT Secret for Web Crypto HMAC-SHA256 session tokens
JWT_SECRET=replace-with-a-secure-random-secret-key-for-jwt-tokens

# Web Push VAPID Keys
# Generate via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BBDKJCtwk4-qoiufaMn3TNo4Z7naPIRCoV6bZc8jCYK9PdrFZiADi0159l9HEqQg4qlL0f7e4lFB-tvBxEQZB64
